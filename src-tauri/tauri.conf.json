{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cuadra",
  "version": "0.1.0",
  "identifier": "app.cuadra.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Cuadra",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' http://127.0.0.1:* https://api.cuadra.app https://releases.cuadra.app ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/cuadra-sidecar"],
    "category": "Productivity",
    "shortDescription": "Sistema operativo para gimnasios",
    "longDescription": "Cuadra — gestión integral para gimnasios pequeños y medianos. Funciona offline."
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://releases.cuadra.app/{{target}}/{{current_version}}"
      ],
      "dialog": false,
      "pubkey": "REPLACE_ME_WITH_TAURI_UPDATER_PUBKEY"
    }
  }
}
