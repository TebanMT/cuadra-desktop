{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tinta",
  "version": "0.5.0",
  "identifier": "app.tinta.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Tinta",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' http://127.0.0.1:* https://127.0.0.1:* ws://127.0.0.1:* wss://127.0.0.1:* https://api.entinta.app https://releases.entinta.app https://github.com https://*.githubusercontent.com ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "tinta-sidecar"
    ],
    "category": "Productivity",
    "shortDescription": "Sistema operativo para gimnasios",
    "longDescription": "Tinta — gestión integral para gimnasios pequeños y medianos. Funciona offline."
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://api.entinta.app/api/v1/releases/latest/{{target}}/{{current_version}}"
      ],
      "dialog": false,
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "REEMPLAZAR_CON_PUBKEY_REAL_VER_docs_release_md"
    }
  }
}